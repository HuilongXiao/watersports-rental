# Local configuration example. Do not commit a real .env file.
DATABASE_URL=sqlite:///./data/rental_app.db
TZ=Asia/Shanghai
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-this-password
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false

# Set to "false" for fresh installs (no default group/customer/settings).
SEED_DEFAULT_DATA=true

# Password recovery: set to a new password and restart to reset the superuser.
# Remove after successful reset.
# SUPERUSER_PASSWORD_RESET=newpassword

# Request timing middleware: X-Server-Timing header + JSON log per request.
# Default on for dev/debug; set 0/false to disable in production.
REQUEST_TIMING=1
# Log directory (default: <project>/data/logs, mounted to host ./data in Docker).
# LOG_DIR=/app/data/logs

# POST /api/_trace client trace reporting. Default off; enable with 1/true.
# Requires frontend localStorage['enable_tracing']='1' to actually send.
TRACE_REPORT_ENABLED=0

# Payment methods feature flag. Default off (0): management API returns 404,
# orders ignore payment_method_code. Enable with 1 to activate the full flow.
ENABLE_PAYMENT_METHOD=0
